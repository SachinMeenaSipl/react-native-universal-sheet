{
  "name": "react-native-universal-sheet",
  "version": "0.1.0",
  "description": "Native bottom sheets, modals, alerts, toasts and popovers for React Native, Expo and web. Stacked sheets, snap points and full design control with one API on iOS, Android and web.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "source": "src/index.ts",
  "license": "MIT",
  "author": "Sachin Meena",
  "homepage": "https://sachinmeenasipl.github.io/react-native-universal-sheet/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SachinMeenaSipl/react-native-universal-sheet.git"
  },
  "bugs": {
    "url": "https://github.com/SachinMeenaSipl/react-native-universal-sheet/issues"
  },
  "files": [
    "LICENSE",
    "src",
    "!src/__tests__",
    "ios",
    "android",
    "react-native-universal-sheet.podspec",
    "react-native.config.js",
    "README.md",
    "app.plugin.js"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "docs:dev": "npm --prefix website run dev",
    "docs:build": "npm --prefix website run build"
  },
  "keywords": [
    "react-native",
    "react-native-sheet",
    "bottom-sheet",
    "react-native-bottom-sheet",
    "native-bottom-sheet",
    "modal",
    "react-native-modal",
    "dialog",
    "alert",
    "action-sheet",
    "popover",
    "tooltip",
    "drawer",
    "notification-sheet",
    "toast",
    "snackbar",
    "sheet",
    "stacked-sheets",
    "snap-points",
    "native-modal",
    "uisheetpresentationcontroller",
    "bottomsheetdialog",
    "ios",
    "android",
    "expo",
    "fabric",
    "turbomodule",
    "react-native-web",
    "web",
    "expo-plugin"
  ],
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0",
    "react-dom": ">=18.2.0",
    "react-native-web": ">=0.19.0",
    "expo": ">=51.0.0"
  },
  "codegenConfig": {
    "name": "NativeSheetSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.universalsheet"
    }
  },
  "devDependencies": {
    "@expo/config-plugins": "9.0.17",
    "@types/jest": "29.5.14",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jest": "29.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-web": "0.19.13",
    "ts-jest": "29.2.5",
    "typescript": "5.6.3"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "react-native-web": {
      "optional": true
    },
    "expo": {
      "optional": true
    }
  }
}
